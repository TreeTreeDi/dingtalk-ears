{
  "name": "dingtalk-ears",
  "version": "0.3.1",
  "private": true,
  "description": "Development checks for the Python DingTalk inbox; no frontend build required",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "lint:css": "stylelint 'backend/static/**/*.css'",
    "lint:css:fix": "npm run lint:css -- --fix",
    "lint:js": "eslint backend/static/panel.js",
    "lint": "npm run lint:css && npm run lint:js",
    "format": "prettier --write backend/static package.json '*.cjs' '*.mjs' 'config.example.json'",
    "format:check": "prettier --check backend/static package.json '*.cjs' '*.mjs' 'config.example.json'",
    "check": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "stylelint": "16.15.0",
    "stylelint-config-standard": "37.0.0"
  },
  "overrides": {
    "stylelint": {
      "file-entry-cache": {
        "flat-cache": "6.1.8"
      }
    }
  }
}
